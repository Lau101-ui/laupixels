# LAUPIXELS API configuration.
NODE_ENV=development
HOST=0.0.0.0
PORT=8787

# Host-run API: use localhost. Docker Compose overrides DATABASE_URL to use the db service.
DATABASE_URL="postgresql://laupixels:CHANGE_ME@localhost:5432/laupixels?schema=public"

# Replace with at least 32 random bytes before starting the API.
JWT_SECRET=CHANGE_ME

# Exact browser origin(s), comma-separated. Do not use a wildcard.
CORS_ORIGINS=http://localhost:8000

# HTTPS hosts for approved third-party image URLs only.
# R2-hosted images are selected through their verified upload IDs, not this list.
ASSET_HOSTS=images.unsplash.com

# Cloudflare R2. Leave ALL R2 values blank for local development without uploads.
# Use two different buckets: one private staging bucket and one public-read delivery bucket.
# Scope the API token to Object Read & Write on these two buckets only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_BUCKET=
R2_PUBLIC_BUCKET=
# HTTPS custom domain for the public delivery bucket; r2.dev is for demos only.
R2_PUBLIC_BASE_URL=

ADMIN_EMAIL=admin@example.com
# Replace with a unique password of at least 14 characters before running the seed.
ADMIN_INITIAL_PASSWORD=replace-this-with-a-unique-password

LOG_LEVEL=info
